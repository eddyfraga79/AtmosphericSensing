    {
        "id": "bed449f6830c9d60",
        "type": "function",
        "z": "1f67e315577c15a4",
        "name": "SetPayloadInTable",
        "func": "// Max number of rows to keep\nconst MAX_ROWS = 8;\n\n// Get the current table data from flow context\nlet table = flow.get(\"fifo_table\") || [];\n\n// Create a new row\nconst newRow = {\n    Time: new Date().toLocaleTimeString(),\n    Topic: msg.topic,\n    Value: msg.payload\n};\n\n// Add the new row at the top\ntable.unshift(newRow);\n\n// Trim the array to exactly MAX_ROWS items\nif (table.length > MAX_ROWS) {\n    table = table.slice(0, MAX_ROWS);\n}\n\n// Save the updated table back to context\nflow.set(\"fifo_table\", table);\n\n// Send it to the UI Table\nmsg.payload = table;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is started.\n// Clear the device table on deploy/start\nflow.set(\"fifo_table\", []);",
