    {
        "id": "866e7e446f57c646",
        "type": "function",
        "z": "1f67e315577c15a4",
        "name": "RefactorSensorStatusData",
        "func": "// --- CONFIG ---\nconst MAX_ROWS = 4; // number of rows to keep\n\n// --- STARTUP CLEAR ---\nif (msg.startup) {\n    // Clear table in flow context\n    flow.set(\"device_table\", []);\n    // Send empty array to UI Table to clear front-end\n    msg.payload = [];\n    return msg;\n}\n\n// --- NORMAL MQTT PROCESSING ---\nlet payload = msg.payload;\n\n// If payload is JSON, extract status\nif (typeof payload === \"object\") {\n    if (payload.status) payload = payload.status;\n} else {\n    try {\n        let parsed = JSON.parse(payload);\n        if (parsed.status) payload = parsed.status;\n    } catch (e) {\n        // Not JSON, leave as-is\n    }\n}\n\n// Extract device ID from topic, remove colons\nlet topicParts = msg.topic.split(\"/\");\nlet deviceId = topicParts[1] || \"unknown\";\ndeviceId = deviceId.replace(/:/g, \"\").toLowerCase();\n\n// Build status string\nlet icon = (payload === \"online\" || payload === \"alive\") ? \"🟢\" : \"🔴\";\nlet localTime = new Date().toLocaleTimeString('en-US', {\n    hour12: false,\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n    second: \"2-digit\"\n});\nlet statusText = `${icon} ${payload} (${localTime})`;\n\n// --- FIFO LOGIC ---\nlet table = flow.get(\"device_table\") || [];\n\n// Update existing device row or add new\nlet index = table.findIndex(row => row.Device === deviceId);\nif (index !== -1) {\n    table[index].Status = statusText;\n} else {\n    table.unshift({ Device: deviceId, Status: statusText });\n}\n\n// Keep only MAX_ROWS\nif (table.length > MAX_ROWS) table = table.slice(0, MAX_ROWS);\n\n// Save back to flow context\nflow.set(\"device_table\", table);\n\n// Output to UI Table\nmsg.payload = table;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is started.\n// Clear the device table on deploy/start\nflow.set(\"device_table\", []);",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 140,
        "wires": [
            [
                "fbe0f090da3c9abc"
            ]
        ]
    },
