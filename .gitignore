# Ignore Python cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore virtual environments
.venv/
env/
venv/

# Ignore environment files
*.env

# Ignore logs and temporary files
*.log
*.tmp

# Ignore database files
*.db

# Node-RED sensitive and generated files
nodeFlow/flows_cred.json
nodeFlow/node_modules/
nodeFlow/settings.js
nodeFlow/package-lock.json
nodeFlow/.config.*
nodeFlow/.sessions.json
nodeFlow/*.backup
nodeFlow/*.tmp
